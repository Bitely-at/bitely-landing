# Copy to .env.local for local development, and set the same three values in
# Netlify (Site configuration -> Environment variables) for production.
# .env.local is gitignored - never commit real keys.

# Resend API key - https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=

# Inbox that receives the demo requests. Any mailbox you can read.
DEMO_REQUEST_TO=hello@bitely.at

# From address shown on the email. Must be on the domain verified in Resend
# (send.bitely.at). The mailbox itself does not need to exist.
DEMO_REQUEST_FROM=Bitely <demo@send.bitely.at>
